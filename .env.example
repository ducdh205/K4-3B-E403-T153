# ==============================================================================
# BIẾN MÔI TRƯỜNG & API KEY HỆ THỐNG AI QUIZ PLATFORM
# ==============================================================================

# 1. API Key cho Google Gemini (Dùng để AI sinh câu hỏi thật từ nội dung slide)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Hoặc API Key cho OpenAI (Nếu muốn dùng GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# 3. Cấu hình Cơ sở dữ liệu MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=quizai_db
